# ── Dependencies & build artefacts ────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
# Exception: the kiosk Electron apps have build/ folders that hold
# app icons + icon generator scripts. Those are SOURCE, not
# generated, so they must ship with the repo.
!kiosk-app/build/
!kiosk-app/build/**
!printloop-kiosk-app/build/
!printloop-kiosk-app/build/**

# ── Local secrets (never commit) ─────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS / editor ──────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
Thumbs.db

# ── Backend runtime data ─────────────────────────────────────────────
# The SQLite DB is created automatically by the seed on first boot;
# committing it would carry test users + jobs into every clone and
# produce noisy binary diffs.
01-backend/data/printloop.sqlite
01-backend/data/printloop.sqlite-*
# Uploaded customer documents — real user content, never commit.
01-backend/data/uploads/
# Test artefacts captured by the virtual printer.
01-backend/data/printed/
# Legacy mock JSON store used by the devApi catch-all router.
01-backend/data/dev-store.json

# ── Vendored reference source (not built, not imported) ──────────────
# Local clones of OpenPrinting projects kept for reference only. The app
# uses cups-filters / Ghostscript at runtime on the host, never this
# source. Untracked to keep the repo lean (~139 MB); re-clone if needed.
vendor/

# ── Archives / large binaries ────────────────────────────────────────
*.tar
*.zip

.vercel
