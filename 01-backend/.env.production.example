# ─────────────────────────────────────────────────────────────────────
# PrintLoop API — PRODUCTION environment template (V2-21)
# Copy to your platform's secret store. Never commit real values.
# ─────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
APP_VERSION=2.0.0
# Comma-separated origins allowed to call the API with credentials.
ALLOWED_ORIGINS=https://app.printloop.app,https://printloop.app

# ── Database (Postgres REQUIRED in prod) ──────────────────────────────
# SQLite is single-writer — never use it with >1 API instance. Set a
# managed Postgres URL (Neon / Supabase / Railway / RDS). The driver
# auto-selects Postgres when DATABASE_URL starts with postgres(ql)://.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/printloop
DB_SSL=true
DB_POOL_MAX=10

# ── Redis (REQUIRED — BullMQ + rate limits + idempotency) ─────────────
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# ── Auth ──────────────────────────────────────────────────────────────
# 32+ random chars. `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ── SaaS / multi-tenancy ──────────────────────────────────────────────
COMMISSION_PCT_DEFAULT=0.10

# Demo data seeding — NEVER set this to 1 in production. It plants
# admin@printloop.test / Admin1234! and three other accounts whose
# passwords are public in this repo. The default (unset/0) gives you a
# clean DB; bootstrap your first SUPER_ADMIN with
#   tsx scripts/createSuperAdmin.ts <email> <password>
# See DEPLOY-SAAS.md §3a.
SEED_DEMO=0
# Domains we own — hosts ending in these resolve to {slug}.<apex>;
# anything else is treated as a tenant custom domain.
PRINTLOOP_APEX_DOMAINS=printloop.app
# CNAME target tenants point their custom domains at (the TLS edge).
PRINTLOOP_DOMAINS_CNAME=domains.printloop.app

# ── Render worker callback (shared secret, both sides) ────────────────
# `openssl rand -hex 32`. Must match render-worker's RENDER_CALLBACK_SECRET.
RENDER_CALLBACK_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Payments (Paystack — live keys) ───────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxx
# Optional dedicated webhook-signing secret; falls back to SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=

# ── File storage (S3-compatible) ──────────────────────────────────────
# Used by the render-worker for source + rendered artifacts.
S3_BUCKET=printloop-prod
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Cloudinary (image transforms — optional) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (transactional — Resend / Postmark / SES SMTP) ──────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=PrintLoop <noreply@printloop.app>

# ── SMS (Termii) ──────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=PrintLoop

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ── Error reporting (V2-34) — Sentry ──────────────────────────────────
# Leave SENTRY_DSN unset to disable error reporting; production
# deployments paste their project DSN here. The SDK is wired but
# strictly no-ops without a DSN, so dev runs don't talk to Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
