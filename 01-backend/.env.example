# ─────────────────────────────────────────────────────────
# PrintLoop API — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://printloop.ng

# Database — driver auto-detected.
#   - If DATABASE_URL is set and starts with `postgres://` / `postgresql://`,
#     the app boots against Postgres. Required for horizontal scaling
#     (SQLite is single-writer).
#   - Otherwise the app boots against the SQLite file at `data/printloop.sqlite`
#     (or `DATABASE_FILE` if set). Fine for single-tenant single-instance dev.
#
# Postgres extras:
#   - DB_POOL_MAX: connection pool size (default 10).
#   - DB_SSL=true: required by most managed providers (Neon, Supabase,
#     Railway Postgres). rejectUnauthorized=false so self-signed certs work.
# DATABASE_URL=postgresql://user:password@localhost:5432/printloop
# DB_POOL_MAX=10
# DB_SSL=true
# DATABASE_FILE=./data/printloop.sqlite

# Redis (used for caching + BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack (payments)
# ⚠️ CRITICAL: Use TEST keys (pk_test_... / sk_test_...) in dev/staging.
# LIVE keys (pk_live_... / sk_live_...) charge REAL MONEY — never commit them.
# WEBHOOK_SECRET verifies HMAC-SHA512 of the raw webhook body.
# If unset, the SECRET_KEY is used as the HMAC key (Paystack's default).
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# SaaS — multi-tenancy + commission model (Phase A of SAAS-ROADMAP.md)
# COMMISSION_PCT_DEFAULT — Bolt-Nigeria style platform commission.
#   Decimal fraction; 0.10 = 10%. Stored per-tenant on first signup,
#   negotiable downward for volume.
# PRINTLOOP_APEX_DOMAINS — comma-separated list of domains we own.
#   Hosts ending in one of these resolve to the subdomain tenant
#   ({slug}.printloop.app); other hosts are looked up as custom domains.
# RENDER_CALLBACK_SECRET — shared secret between this API and the
#   standalone render-worker (../render-worker/). Every callback is
#   HMAC-SHA256 signed against the raw request body. Generate with
#   `openssl rand -hex 32`. If unset, /api/render/* refuses every
#   request — safer than a permissive default.
COMMISSION_PCT_DEFAULT=0.10
PRINTLOOP_APEX_DOMAINS=printloop.app,printloop.test
RENDER_CALLBACK_SECRET=

# Custom domains (Dimension 8). The CNAME value tenants point their
# domain at; the edge (Cloudflare for SaaS / Caddy on-demand-TLS)
# terminates TLS and forwards to the API.
PRINTLOOP_DOMAINS_CNAME=domains.printloop.app

# Structured logging (V2-16).
#   LOG_LEVEL: debug | info | warn | error (default info)
#   LOG_PRETTY: true for human-readable dev output; unset = JSON lines
LOG_LEVEL=info
LOG_PRETTY=false

# Email (SMTP - use SendGrid, Mailgun, AWS SES etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PrintLoop <noreply@printloop.ng>

# SMS (Termii - popular in Nigeria)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=PrintLoop

# Stripe (optional - for international payments)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase (optional - for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Office → PDF conversion (V2-48 black box). Lets students upload
# .docx/.pptx/.xlsx etc. Unset/none = office uploads rejected (PDF +
# images only, today's behaviour). docker-compose provisions Gotenberg.
#   DOC_CONVERTER = gotenberg | soffice | none   (default: auto)
#   - auto: uses gotenberg when GOTENBERG_URL is set, else off
DOC_CONVERTER=
GOTENBERG_URL=
# LIBREOFFICE_BIN=/usr/bin/soffice   # only for DOC_CONVERTER=soffice
# DOC_CONVERT_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────
# Document Editor (V2-XX — online editing for print shops)
# ─────────────────────────────────────────────────────────
# LibreOffice Headless URL for PDF/DOCX/ODT → Univer conversion
LIBREOFFICE_URL=http://localhost:9980
LIBREOFFICE_UNO_URL=socket,host=libreoffice,port=2002;urp;StarOffice.ComponentContext

# Coturn TURN/STUN server for WebRTC NAT traversal
COTURN_PASSWORD=changeme
SERVER_PUBLIC_IP=your-server-ip
TURN_SERVER=turn.printloop.app:3478
TURN_TLS_SERVER=turn.printloop.app:5349

# Univer editor configuration
UNIVER_CDN_URL=https://cdn.jsdelivr.net/npm/@univerjs
UNIVER_VERSION=3.x

# Editor session settings
EDITOR_SESSION_TTL_HOURS=24
EDITOR_SNAPSHOT_INTERVAL_MS=30000
EDITOR_MAX_SNAPSHOTS=50
