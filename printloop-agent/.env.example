# ── PrintLoop Agent — config (copy to .env, edit, never commit) ─────────
#
# This file is the ONLY config the agent reads. Everything else is hard-
# coded into agent.ts so a sysadmin can copy this once and forget it.
#
# ─ Auto-install path (Windows) ────────────────────────────────────────
# On Windows, `install.ps1` from an Administrator PowerShell will:
#   1. Install Node.js LTS (via winget; falls back to Chocolatey)
#   2. Install SumatraPDF — silent PDF printing for spooler mode
#   3. Install Ghostscript (optional; pass -NoGhostscript to skip)
#   4. Run `npm install` for the agent
#   5. Run the .env wizard (incl. printer-queue picker for spooler)
#   6. Register a boot-time Scheduled Task that auto-restarts on crash
# You can re-run install.ps1 any time — every step is idempotent.

# ─ Cloud backend ─────────────────────────────────────────────────────
# Where the cloud-hosted PrintLoop backend lives. The agent polls
# /api/agent/jobs/ready on this base URL.
PRINTLOOP_BASE_URL=https://printloop-production.up.railway.app

# The kiosk's API key — same X-Kiosk-Key the in-browser kiosk panel uses.
# Generated by an admin from the Admin → Kiosks tab. Treat like a password.
KIOSK_API_KEY=replace-with-real-kiosk-key

# ─ Local printer ─────────────────────────────────────────────────────
# IP address or local printer queue name.
PRINTER_IP=192.168.0.111

# Transport mode:
# - 'ipp': Standard IPP Print-Job over HTTP (default).
# - 'raw9100': TCP raw socket + PJL (needed for Sharp MX-series).
# - 'spooler': Local OS Print Spooler (supports GDI/USB/local printers).
# - 'printnode': PrintNode cloud proxy — works with ANY printer behind NAT/firewall.
# - 'lpd': Legacy LPD/LPR protocol (port 515) — legacy enterprise printers.
# - 'email': Email-to-print — for HP ePrint, Canon PRINT, Epson Email Print.
PRINTER_TRANSPORT=raw9100

# Name of the local print queue (only used when PRINTER_TRANSPORT=spooler/email).
# If not specified, falls back to the value of PRINTER_IP.
PRINTER_NAME=My_Local_USB_Printer

# Command template for spooler printing (only used when PRINTER_TRANSPORT=spooler).
# Supported variables:
#   {file}    - Absolute path of the temporary file containing print bytes
#   {printer} - Sanitized name of the target printer (from PRINTER_NAME)
#   {jobName} - Sanitized name of the print job
#
# Defaults (used when SPOOLER_COMMAND is unset):
#   Windows: powershell -Command "Start-Process -FilePath '{file}' -Verb PrintTo '{printer}'"
#   Linux/macOS: lp -d '{printer}' '{file}'
#
# RECOMMENDED on Windows — SumatraPDF for byte-faithful PDF printing
# (the default PowerShell PrintTo can re-rasterize PDFs and lose quality).
# install.ps1 sets this for you when it detects SumatraPDF:
# SPOOLER_COMMAND="C:\Program Files\SumatraPDF\SumatraPDF.exe" -print-to "{printer}" "{file}"

# IPP port (only used when PRINTER_TRANSPORT=ipp). 631 is the IANA
# IPP/IPPS port — almost every networked printer.
PRINTER_PORT=631

# IPP path. Sharp MX-series = /ipp/lp ; CUPS queues = /printers/<name> ;
# IPP-Everywhere / AirPrint = /ipp/print (default).
IPP_PATH=/ipp/print

# IPP protocol version. Default 2.0 (IPP-Everywhere). Set to 1.1 for
# Sharp MX-series and other older / vendor-quirky firmwares.
IPP_VERSION=1.1

# Raw-socket port (only used when PRINTER_TRANSPORT=raw9100). 9100 is
# the de facto standard ("JetDirect" / "AppSocket") port.
PRINTER_RAW_PORT=9100

# ─ PrintNode Cloud Proxy (transport: printnode) ──────────────────────
# Works with ANY printer behind NAT/firewall — no port forwarding needed.
# Sign up at https://www.printnode.com — get API key and printer ID.
PRINTNODE_API_KEY=your-printnode-api-key
PRINTNODE_PRINTER_ID=123456

# ─ LPD/LPR Legacy Protocol (transport: lpd) ──────────────────────────
# Legacy line printer daemon (port 515) — still used by some enterprise
# printers, Kyocera, Ricoh, and Unix/Linux print servers.
LPD_QUEUE=lp

# ─ Email-to-Print (transport: email) ─────────────────────────────────
# For printers with email printing: HP ePrint, Canon PRINT, Epson Email Print.
# Requires SMTP credentials in env vars.
EMAIL_TO_PRINT_ADDRESS=printer123@hpeprint.com

# SMTP settings for email-to-print
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="PrintLoop <noreply@printloop.ng>"
SMTP_SECURE=false

# ─ Tuning ────────────────────────────────────────────────────────────
# How often to poll the cloud for new jobs (milliseconds). 4 seconds
# feels instant to the customer at the kiosk; lower if you want.
POLL_INTERVAL_MS=4000

# How long to wait for the printer to confirm a job (V2-44).
CONFIRM_TIMEOUT_MS=90000

# CONFIRM_DISABLE=1 skips confirmation polling entirely.
CONFIRM_DISABLE=0