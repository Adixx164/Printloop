# Caddyfile — PrintLoop Production TLS + Reverse Proxy

# Install: `sudo apt install caddy` (Debian/Ubuntu) or `brew install caddy`
# Run: `caddy run --config /etc/caddy/Caddyfile`
# Systemd: `sudo systemctl enable --now caddy`

{
	# Let's Encrypt ACME (staging for testing, remove `ca` for prod)
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	email admin@printloop.ng
	# Logging
	admin off
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# ──────────────────────────────────────────────────────────────
# API (backend) — port 4000
# ──────────────────────────────────────────────────────────────
api.printloop.app {
	reverse_proxy localhost:4000 {
		# WebSocket upgrade for any future real-time features
		transport http {
			# Keep connections alive for agent long-polling
			read_buffer 4KB
			write_buffer 4KB
		}
	}
	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	# Rate limiting at edge (defence in depth; app also limits)
	rate_limit {
		zone api 10r/s
		key {remote_host}
	}
	# Access log
	log {
		output file /var/log/caddy/api_access.log
		format json
	}
}

# ──────────────────────────────────────────────────────────────
# Frontend (Vite build) — static files
# ──────────────────────────────────────────────────────────────
printloop.app {
	root * /var/www/printloop-frontend
	try_files {path} /index.html
	file_server {
		# Cache static assets aggressively
		@immutable {
			path /assets/*
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	log {
		output file /var/log/caddy/frontend_access.log
		format json
	}
}

# ──────────────────────────────────────────────────────────────
# Tenant custom domains (on-demand TLS) — optional
# ──────────────────────────────────────────────────────────────
# If a tenant configures a custom domain (e.g. print.myschool.edu),
# Caddy will automatically obtain a cert for it via ACME on first request.
# Requires: tenant's DNS A/CNAME → this server IP.
# The app reads `Host` header to resolve the tenant.
{
	on_demand_tls {
		ask https://api.printloop.app/api/integrations/tls-check
		interval 3600
		burst 10
	}
}

# Catch-all for on-demand tenant domains
:443 {
	tls {
		on_demand
	}
	reverse_proxy localhost:4000
}

# ──────────────────────────────────────────────────────────────
# Health check endpoint (for LB / uptime monitoring)
# ──────────────────────────────────────────────────────────────
health.printloop.app {
	respond "OK" 200
}

# ──────────────────────────────────────────────────────────────
# Redirect www → apex
# ──────────────────────────────────────────────────────────────
www.printloop.app {
	redir https://printloop.app{uri} permanent
}