# PrintLoop Waitlist — Environment Variables
# Copy this file to .env.local and fill in your values

# ========================================
# REQUIRED FOR PRODUCTION
# ========================================

# API Base URL (for custom backend)
# VITE_API_BASE=https://api.printloop.ng

# ========================================
# NETLIFY FUNCTIONS (Default - No Setup Needed)
# ========================================
# Works out of the box with `netlify dev` or Netlify deploy
# No environment variables required for local development

# ========================================
# SUPABASE (Optional - For Production Database)
# ========================================
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ========================================
# ANALYTICS (Optional)
# ========================================
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=printloop.ng

# ========================================
# FEATURE FLAGS
# ========================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_MOCK_MODE=true