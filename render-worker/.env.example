# Render Worker Environment Variables
# Copy to .env and fill in values

# Redis (required for BullMQ)
REDIS_URL=redis://localhost:6379

# S3 / R2 Storage (required)
AWS_REGION=us-east-1
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=printloop-renders
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=true

# Render settings
RENDER_CONCURRENCY=2
RENDER_DEFAULT_DPI=300
RENDER_MAX_DPI=600
RENDER_TEMP_DIR=/tmp/printloop-render

# Backend callback (required)
RENDER_CALLBACK_URL=http://backend:4000/api/internal/render/callback
RENDER_CALLBACK_SECRET=your-hmac-secret-must-match-backend

# Logging
LOG_LEVEL=info
NODE_ENV=development