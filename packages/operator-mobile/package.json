{
  "name": "@printloop/operator-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-router": "~3.4.0",
    "expo-notifications": "~0.27.0",
    "expo-sqlite": "~13.0.0",
    "expo-task-manager": "~11.0.0",
    "expo-background-fetch": "~11.0.0",
    "expo-secure-store": "~12.0.0",
    "expo-constants": "~15.0.0",
    "expo-linking": "~6.0.0",
    "expo-dev-client": "~3.0.0",
    "expo-status-bar": "~1.11.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.0",
    "react-native-screens": "~3.29.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@reduxjs/toolkit": "^2.2.3",
    "react-redux": "^9.1.2",
    "socket.io-client": "^4.7.4",
    "@printloop/shared": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "~18.2.0",
    "typescript": "^5.4.5",
    "@types/react-native": "~0.73.0"
  },
  "expo": {
    "name": "PrintLoop Operator",
    "slug": "printloop-operator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "printloop-operator",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F4ED"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.printloop.operator",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "background-fetch"],
        "NSUserNotificationsUsageDescription": "Receive push notifications for print job alerts",
        "NSCameraUsageDescription": "Scan QR codes to collect print jobs",
        "NSBluetoothAlwaysUsageDescription": "Connect to Bluetooth printers for test prints"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F4ED"
      },
      "package": "com.printloop.operator",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}