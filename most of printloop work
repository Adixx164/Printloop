     user-triggered hover transforms stay, matching .pl-btn:hover. */

  /* Masthead stamps down once on load. */
  @keyframes pl-drop-in {
    from { opacity: 0; transform: translateY(-14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .pl-anim-header { animation: pl-drop-in 460ms cubic-bezier(0.16, 1, 0.3, 1) both; }

  /* Nav link / chrome button: lifts a hair on hover, presses flat on tap. */
  .pl-nav-link {
    transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1),
                background-color 150ms, color 150ms, border-color 150ms;
  }
  .pl-nav-link:hover { transform: translateY(-2px); }
  .pl-nav-link:active { transform: translateY(0); }

  /* Arrow nudges right as the button lifts (Button.tsx �+' span.pl-arrow). */
  .pl-arrow { transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1); }
  .pl-btn:hover .pl-arrow { transform: translateX(4px); }

  /* Keyboard focus: hard persimmon outline �?" on-brand, no soft glow. */
  .pl-btn:focus-visible,
  .pl-nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #f8f4ed, 0 0 0 4px #d14b2c;
  }

  /* Footer fleuron turns on hover. */
  .pl-ornament { display: inline-block; transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1); }
  .pl-ornament:hover { transform: rotate(180deg); }

  /* Mobile-drawer items slide + fade in, staggered, as the drawer opens. */
  .pl-drawer-item {
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pl-drawer-item[data-open="false"] { opacity: 0; transform: translateX(14px); }
  .pl-drawer-item[data-open="true"]  { opacity: 1; transform: translateX(0); }

  /* �"?�"? CSS-3D scene (V2-45) �"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?�"?
     Real perspective + preserve-3d, GPU-composited, no WebGL �?" runs
     on a low-end Android. The scroll-driven transforms are written to
     element.style by Printer3D.tsx; these classes only set up the 3D
     context and the static cuboid faces. */
  .pl-3d { transform-style: preserve-3d; }
  .pl-face {
    position: absolute;
    left: 50%;
    top: 50%;
    backface-visibility: hidden;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-reveal, .pl-reveal[data-shown] {
      transition: none;
      opacity: 1;
      transform: none;
      clip-path: none;
    }
    .pl-typeset .pl-word {
      transition: none;
      opacity: 1;
      transform: none;
    }
    /* Chrome motion (V2-48): drop the auto-playing entrances; the
       hover micro-lifts are user-triggered and stay, matching .pl-btn. */
    .pl-anim-header { animation: none; }
    .pl-drawer-item,
    .pl-drawer-item[data-open="false"],
    .pl-drawer-item[data-open="true"] {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Pulse animation for collaboration cursors */
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.1); }
  }
